# ─── Nova Suites frontend — environment variables ─────────────────────────────
# Copy to `.env.local` for local development. Never commit real values.
#
# Everything prefixed NEXT_PUBLIC_ is inlined into the browser bundle and is
# therefore PUBLIC. Do not put secrets here — the Paystack secret key, JWT
# secret, and database credentials belong to the backend only.

# Base URL of the Spring Boot API.
# Local development: http://localhost:8080
# Production (Vercel): the Render service URL, e.g. https://nova-suites-api.onrender.com
NEXT_PUBLIC_API_URL=http://localhost:8080

# Google OAuth client ID (public by design — it is sent to Google in the browser).
# Leave blank to hide/disable the Google sign-in button.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Public hotel contact details. Leave optional values blank until the business
# owner confirms them; blank values are hidden rather than replaced with demos.
NEXT_PUBLIC_HOTEL_ADDRESS=
NEXT_PUBLIC_HOTEL_PHONE=
NEXT_PUBLIC_HOTEL_EMAIL=
NEXT_PUBLIC_HOTEL_LEGAL_EMAIL=
